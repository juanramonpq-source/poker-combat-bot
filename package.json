{
  "name": "poker-combat-bot-online",
  "version": "1.0.2",
  "description": "Juego de combate entre mechas - Multiplayer Online con Socket.IO",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "clean:sync": "node scripts/sync-clean-release.js",
    "clean:push": "node scripts/push-clean-release.js",
    "railway:bootstrap-refresh": "node scripts/railway-bootstrap-refresh.js",
    "railway:autodeploy": "node scripts/railway-autodeploy.js",
    "railway:autodeploy:off": "node scripts/railway-autodeploy.js off",
    "railway:autodeploy:on": "node scripts/railway-autodeploy.js on",
    "railway:guard": "node scripts/railway-deploy-guard.js",
    "railway:redeploy": "npm run railway:guard && npx -y @railway/cli service redeploy --service poker-combat-bot --from-source --yes",
    "deploy:railway": "npm run railway:redeploy"
  },
  "keywords": [
    "game",
    "multiplayer",
    "socket.io",
    "poker",
    "combat",
    "mecha"
  ],
  "author": "Juan Ramón Pérez Quintanar",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.5.4"
  },
  "devDependencies": {
    "nodemon": "^2.0.20"
  },
  "engines": {
    "node": "18.x"
  }
}
